# nbads-prebid — environment variable reference
#
# Copy this file to `.env` for your own use / CI, then apply the values to
# Cloudflare. NOTE: `wrangler dev` reads `.dev.vars` (not `.env`). To test
# overrides locally, copy the vars you want into a `.dev.vars` file.
#
# All variables are optional — omit them to use the defaults in `src/config.js`.

# Override the Prebid build service URL.
PREBID_BUILD_ENDPOINT=https://js-download.prebid.org/download

# Default version served when `?v=` is missing or not whitelisted.
PREBID_DEFAULT_VERSION=11.23.0

# Comma-separated whitelist of versions the Worker will build/serve.
PREBID_ALLOWED_VERSIONS=11.23.0

# Override the path this Worker serves.
PREBID_ROUTE_PATH=/nbads/prebid.js

# Comma-separated bidder adapter module names to bundle.
PREBID_BIDDERS=magniteBidAdapter,msftBidAdapter,inmobiBidAdapter,eskimiBidAdapter

# Comma-separated modules always included (consent/GPP, TCF, GPT pre-auction, storage).
PREBID_STANDARD_MODULES=consentManagementTcf,consentManagementGpp,gppControl_usnat,gppControl_usstates,tcfControl,gptPreAuction,storageControl

# Cache-Control sent to clients / primary edge cache.
PREBID_CACHE_CONTROL=max-age=604800, public, s-maxage=86400

# Cache-Control for the long-lived "last-known-good" fallback cache entry.
PREBID_FALLBACK_CACHE_CONTROL=max-age=31536000, public, s-maxage=31536000

# Upstream download retry attempts (0 = no retry).
PREBID_MAX_RETRIES=3

# Base delay (ms) between retry attempts.
PREBID_RETRY_DELAY_MS=500
